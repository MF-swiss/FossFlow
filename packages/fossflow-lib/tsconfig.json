{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "src/*": ["./*"]
    },
    "outDir": "./dist",
    "declaration": false,
    "declarationMap": false
  },
  "exclude": [
    "node_modules",
    "./dist",
    "./docs",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/global.d.ts"
  ]
}